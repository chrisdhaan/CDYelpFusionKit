":"text","text":" "},{"type":"text","text":"not once per retry attempt. If a retry occurs (see "},{"type":"codeVoice","code":"CDYelpRetryConfiguration"},{"type":"text","text":"), the same"},{"type":"text","text":" "},{"type":"text","text":"already-adapted request is resent unchanged. An adapter that refreshes an expiring token or"},{"type":"text","text":" "},{"type":"text","text":"signs requests with a per-attempt nonce\/timestamp will not get a fresh value on retry; such"},{"type":"text","text":" "},{"type":"text","text":"an adapter should refresh proactively before the request reaches CDYelpFusionKit, rather than"},{"type":"text","text":" "},{"type":"text","text":"relying on being re-invoked mid-retry."}],"type":"paragraph"}]},{"type":"aside","content":[{"inlineContent":[{"text":"An error thrown from ","type":"text"},{"code":"adapt(_:)","type":"codeVoice"},{"text":" must be safe to share across concurrency domains —","type":"text"},{"text":" ","type":"text"},{"text":"it crosses an actor boundary on its way to the caller. If the error is already a","type":"text"},{"type":"text","text":" "},{"code":"CDYelpNetworkError","type":"codeVoice"},{"type":"text","text":", it is rethrown unchanged; any other error is wrapped in"},{"type":"text","text":" "},{"code":"CDYelpNetworkError.invalidRequest","type":"codeVoice"},{"type":"text","text":". "},{"code":"CDYelpNetworkError","type":"codeVoice"},{"type":"text","text":" is "},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":" specifically"},{"type":"text","text":" "},{"type":"text","text":"to accommodate this, since the protocol itself cannot require "},{"code":"adapt(_:)","type":"codeVoice"},{"type":"text","text":"’s thrown error type"},{"type":"text","text":" "},{"type":"text","text":"to be "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"important","name":"Important"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/c