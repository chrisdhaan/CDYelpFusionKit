{"abstract":[{"type":"text","text":"Authenticate and query the Yelp Fusion API in three steps."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Initialize the Client","type":"heading","level":2,"anchor":"Initialize-the-Client"},{"code":["import CDYelpFusionKit","","let client = CDYelpAPIClient(apiKey: \"your-api-key-here\")"],"syntax":"swift","type":"codeListing"},{"text":"Search for Businesses (Completion Handler)","type":"heading","level":2,"anchor":"Search-for-Businesses-Completion-Handler"},{"code":["client.searchBusinesses(","    byTerm: \"coffee\",","    location: \"San Francisco\",","    latitude: nil,","    longitude: nil,","    radius: nil,","    categories: nil,","    locale: nil,","    limit: 10,","    offset: nil,","    sortBy: .bestMatch,","    priceTiers: nil,","    openNow: nil,","    openAt: nil,","    attributes: nil",") { response in","    guard let businesses = response?.businesses else { return }","    for business in businesses {","        print(business.name ?? \"Unknown\")","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Search for Businesses (Async\/Await, iOS 13+)","type":"heading","level":2,"anchor":"Search-for-Businesses-AsyncAwait-iOS-13+"},{"code":["Task {","    do {","        let response = try await client.searchBusinesses(","            byTerm: \"coffee\",","            location: \"San Francisco\",","            latitude: nil,","            longitude: nil,","            radius: nil,","            categories: nil,","            locale: nil,","            limit: 10,","            offset: nil,","            sortBy: .bestMatch,","            priceTiers: nil,","            openNow: nil,","            openAt: nil,","            attributes: nil","        )","        let businesses = response.businesses ?? []","        print(\"Found \\(businesses.count) businesses\")","    } catch {","        print(\"Search failed: \\(error)\")","    }","}"],"syntax":"swift","type":"codeListing"}]}],"schemaVersion":{"patch":0,"m