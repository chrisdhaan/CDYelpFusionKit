{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Initialize-the-Client","type":"heading","level":2,"text":"Initialize the Client"},{"syntax":"swift","type":"codeListing","code":["import CDYelpFusionKit","","let client = CDYelpAPIClient(apiKey: \"your-api-key-here\")"]},{"type":"heading","level":2,"text":"Search for Businesses (Completion Handler)","anchor":"Search-for-Businesses-Completion-Handler"},{"syntax":"swift","type":"codeListing","code":["client.searchBusinesses(","    byTerm: \"coffee\",","    location: \"San Francisco\",","    latitude: nil,","    longitude: nil,","    radius: nil,","    categories: nil,","    locale: nil,","    limit: 10,","    offset: nil,","    sortBy: .bestMatch,","    priceTiers: nil,","    openNow: nil,","    openAt: nil,","    attributes: nil",") { response in","    guard let businesses = response?.businesses else { return }","    for business in businesses {","        print(business.name ?? \"Unknown\")","    }","}"]},{"text":"Search for Businesses (Async\/Await, iOS 13+)","anchor":"Search-for-Businesses-AsyncAwait-iOS-13+","type":"heading","level":2},{"syntax":"swift","code":["Task {","    do {","        let response = try await client.searchBusinesses(","            byTerm: \"coffee\",","            location: \"San Francisco\",","            latitude: nil,","            longitude: nil,","            radius: nil,","            categories: nil,","            locale: nil,","            limit: 10,","            offset: nil,","            sortBy: .bestMatch,","            priceTiers: nil,","            openNow: nil,","            openAt: nil,","            attributes: nil","        )","        let businesses = response.businesses ?? []","        print(\"Found \\(businesses.count) businesses\")","    } catch {","        print(\"Search failed: \\(error)\")","    }","}"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/me.christopherdehaan.CDYelpFusionKit\/documentation\/CDYelpFusionKit\/GettingStarted","interfaceL